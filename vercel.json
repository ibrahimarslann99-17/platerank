{
  "functions": {
    "api/og.js": {
      "includeFiles": "node_modules/**"
    },
    "api/menu-card.js": {
      "includeFiles": "node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/tt",
      "destination": "/index.html"
    },
    {
      "source": "/ig",
      "destination": "/index.html"
    },
    {
      "source": "/eksi",
      "destination": "/index.html"
    },
    {
      "source": "/r",
      "destination": "/index.html"
    },
    {
      "source": "/x",
      "destination": "/index.html"
    },
    {
      "source": "/yt",
      "destination": "/index.html"
    },
    {
      "source": "/yemek",
      "destination": "/api/yemek"
    },
    {
      "source": "/yemek/:slug",
      "destination": "/api/yemek?s=:slug"
    },
    {
      "source": "/sitemap-yemekler.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/liste",
      "destination": "/api/liste"
    },
    {
      "source": "/liste/:slug",
      "destination": "/api/liste?s=:slug"
    },
    {
      "source": "/yontem",
      "destination": "/api/yontem"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/llms"
    },
    {
      "source": "/lisans",
      "destination": "/lisans.html"
    }
  ],
  "redirects": [
    {
      "source": "/yemek/baklava",
      "destination": "/yemek/baklava-2-dilim",
      "permanent": true
    }
  ]
}
